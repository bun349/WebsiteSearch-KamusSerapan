#################################################################
#    Object Properties
#################################################################

###  http://etimologi.id/ontology#berasalDariBahasa
:berasalDariBahasa rdf:type owl:ObjectProperty ;
                   rdfs:domain :KataSerapan ;
                   rdfs:range :BahasaSumber .


###  http://etimologi.id/ontology#memilikiBentukAsal
:memilikiBentukAsal rdf:type owl:ObjectProperty ;
                    rdfs:domain :KataSerapan ;
                    rdfs:range :KataAsli .


###  http://etimologi.id/ontology#memilikiMakna
:memilikiMakna rdf:type owl:ObjectProperty ;
               rdfs:domain :KataSerapan ;
               rdfs:range :MaknaKata .


#################################################################
#    Data properties
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#value
rdf:value rdf:type owl:DatatypeProperty ;
          rdfs:domain :KataAsli ,
                      :MaknaKata ;
          rdfs:range xsd:string .


